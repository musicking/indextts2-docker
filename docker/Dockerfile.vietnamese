# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=musicking/indextts2:latest
FROM ${BASE_IMAGE}

ARG MODEL_REPO=dinhthuan/index-tts-2-vietnamese
ARG MODEL_REVISION=4bbf2dea317dc2b6f1abfb526da373efc980745b

# The Vietnamese GPT was trained with a different SentencePiece model. Keep
# config, tokenizer, and GPT weights together instead of replacing gpt.pth only.
RUN rm -f checkpoints/config.yaml checkpoints/bpe.model checkpoints/gpt.pth \
    && uv run python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='${MODEL_REPO}', revision='${MODEL_REVISION}', local_dir='checkpoints', allow_patterns=['config.yaml', 'bpe.model', 'gpt.pth'])" \
    && uv run python -c "from pathlib import Path; import sentencepiece as spm; required=['config.yaml','bpe.model','gpt.pth']; assert all((Path('checkpoints')/p).stat().st_size > 0 for p in required); spm.SentencePieceProcessor(model_file='checkpoints/bpe.model')" \
    && rm -rf /root/.cache/huggingface checkpoints/.cache

