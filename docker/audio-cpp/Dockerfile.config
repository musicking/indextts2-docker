# syntax=docker/dockerfile:1.7
# Config-only overlay; publishing checks the source and weight revisions against
# the full source Dockerfile. CI resolves this published version tag to an OCI
# digest before building; validation and publishing reuse the same digest.
ARG API_BASE_IMAGE=dockermaker0/indextts25-api:2.5.5
FROM ${API_BASE_IMAGE}
USER 0:0
COPY --chown=1000:1000 docker/audio-cpp/server.json /etc/indextts/server.json
USER 1000:1000
